{
  "name": "junction2026",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dispatch": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env src/dispatch.ts",
    "bench": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env src/bench.ts",
    "tune": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env src/tune.ts",
    "starter": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env vendor/spread-typescript/starter.ts",
    "reveal-csv": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env vendor/spread-typescript/reveal-csv.ts",
    "sim": "node sim/server.ts",
    "oracle": "node sim/oracle.ts",
    "prober": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env sim/prober.ts",
    "replay": "node sim/replay.ts",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24",
    "typescript": "^6.0.3"
  }
}
