{
  "name": "junction2026",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p spread",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check",
    "format": "biome check --write",
    "test:unit": "node --test \"src/**/*.test.ts\" \"spread/**/*.test.ts\"",
    "test:e2e": "playwright install && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "spread": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA --env-file-if-exists=.env spread/starter.ts",
    "spread:reveal": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA --env-file-if-exists=.env spread/reveal-csv.ts",
    "spread:final": "node --env-file-if-exists=.env spread/starter.ts --final"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@libsql/client": "^0.17.3",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
